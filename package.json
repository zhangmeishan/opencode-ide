{
  "name": "opencode-ide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "build": "node scripts/build.mjs",
    "setup": "node scripts/setup.mjs",
    "start": "node scripts/start.mjs",
    "auth": "node scripts/configure-auth.mjs --reset",
    "check": "tsc -p ide-integration --noEmit",
    "lint:secrets": "git ls-files -z | xargs -0 secretlint",
    "test": "node --test ide-integration/test/*.test.mjs",
    "test:browser": "node scripts/smoke-browser.mjs",
    "test:prototype": "node scripts/check-prototype.mjs"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/semver": "^7.7.1",
    "@types/vscode": "1.109.0",
    "@vscode/vsce": "3.7.1",
    "esbuild": "0.25.12",
    "playwright": "1.59.1",
    "secretlint": "^10.2.2",
    "semver": "^7.7.4",
    "typescript": "5.9.3"
  }
}
